# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# App Configuration
VITE_APP_NAME=Employee Engagement Platform
VITE_APP_URL=http://localhost:5173

# Feature Flags
VITE_ENABLE_QR_VERIFICATION=true
VITE_ENABLE_GPS_VERIFICATION=true
VITE_ENABLE_SOCIAL_FEED=true
VITE_ENABLE_CHALLENGES=true
VITE_ENABLE_LEADERBOARDS=true

# Analytics (optional - will be configured later)
VITE_POSTHOG_KEY=
VITE_SENTRY_DSN=

# API Rate Limits
VITE_RATE_LIMIT_REQUESTS=100
VITE_RATE_LIMIT_WINDOW=60

# Supabase Edge Functions
VITE_SUPABASE_FUNCTIONS_URL=your_supabase_functions_url